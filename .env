# GEMINI_API_KEY: Masukkan API Key Gemini dari https://aistudio.google.com/ app
# (Jika belum ada, bisa dikosongkan atau diisi kunci dummy terlebih dahulu)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# APP_URL: URL Server lokal Anda
APP_URL="http://192.168.14.10"

# Telegram Bot (Opsional - Dapatkan Token dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"
TELEGRAM_CHAT_ID="987654321"

# Email SMTP (Opsional - Untuk Notifikasi Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="email-anda@unmus.ac.id"
SMTP_PASS="password-aplikasi-gmail"

# InfluxDB (Opsional - Jika Anda menggunakan InfluxDB di server)
INFLUXDB_URL="http://localhost:8086"
INFLUXDB_TOKEN="my-influxdb-token"
INFLUXDB_ORG="NetWatch"
INFLUXDB_BUCKET="audit_logs"


# MikroTik RouterOS Configuration (IP 192.168.77.1)
MIKROTIK_HOST="192.168.77.1"
MIKROTIK_USER="netwatch"
MIKROTIK_PASS="26112012"
MIKROTIK_PORT="8728"
MIKROTIK_REST_PORT="80"
